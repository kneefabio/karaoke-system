# Backend Environment Variables - LOCAL DEVELOPMENT
# Copia questo file in .env e configura con i tuoi valori

# MongoDB locale
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database

# CORS - permetti tutte le origini in sviluppo
CORS_ORIGINS=*

# JWT Secret (opzionale, usata per autenticazione admin)
JWT_SECRET=your_jwt_secret_key_here

# Server port (gestito da supervisor)
PORT=8001