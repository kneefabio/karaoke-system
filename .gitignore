# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================================
# KARAOKE SYSTEM - GITIGNORE
# ========================================

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lock files nella root (non necessari)
/yarn.lock
/package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
ENV/
env/

# Testing
/coverage
test_reports/

# Production builds
/build
/frontend/build
dist/
*.tsbuildinfo

# Environment files - NON versionare i file reali
*.env
*.env.local
*.env.development
*.env.production
backend/.env
frontend/.env
backend/.env.production
frontend/.env.production

# MA permetti i template
!*.env.template
!backend/.env.template
!frontend/.env.template
!backend/.env.production.template
!frontend/.env.production.template

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# System files
.DS_Store
*.pem
Thumbs.db

# MongoDB local
data/
mongodb/

# Foto Serate (dati utente)
Foto_Serate/

# Electron dist
electron-overlay/dist/
electron-overlay/out/
electron-overlay/node_modules/

# Archive files
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz

# Build caches
.cache/

# Temporary
*.tmp
*.temp

# Supervisor logs (development)
*.err.log
*.out.log
/var/log/
electron-overlay/node_modules/electron/dist/electron
-e
-e 
