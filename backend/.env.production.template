# Backend Environment Variables - PRODUCTION (Render)
# Copia questo file in .env.production e configura con i tuoi valori

# MongoDB Atlas - Sostituisci con le tue credenziali
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/karaoke_db?retryWrites=true&w=majority
DB_NAME=karaoke_db

# CORS - permetti solo i domini della tua app
CORS_ORIGINS=https://your-frontend.netlify.app,https://your-backend.onrender.com

# JWT Secret - CAMBIA con una chiave sicura!
JWT_SECRET=CAMBIA_QUESTA_CHIAVE_SEGRETA_IN_PRODUZIONE

# Server config
PORT=8001