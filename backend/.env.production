# Environment variables for production deployment

# MongoDB Atlas (richiederò le credenziali)
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/karaoke_db?retryWrites=true&w=majority
DB_NAME=karaoke_db

# CORS - permettere Netlify e Render
CORS_ORIGINS=https://your-frontend.netlify.app,https://your-backend.onrender.com

# JWT Secret (cambia in produzione!)
JWT_SECRET=CAMBIA_QUESTA_CHIAVE_SEGRETA_IN_PRODUZIONE_123456789

# Server config
PORT=8001
